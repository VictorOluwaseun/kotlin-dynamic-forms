{
  "schemaVersion": 1,
  "id": "site-inspection",
  "revision": 1,
  "title": "Site readiness check",
  "description": "Record a short site inspection. Your draft stays on this device until you clear it.",
  "fields": [
    {
      "id": "site_name", "label": "Site name", "type": "text", "required": true,
      "minLength": 3, "maxLength": 80, "placeholder": "e.g. Lekki service centre"
    },
    {
      "id": "inspector", "label": "Inspector name", "type": "text", "required": true,
      "minLength": 2, "maxLength": 80
    },
    {
      "id": "inspection_type", "label": "Inspection type", "type": "choice", "required": true,
      "options": [{"value": "routine", "label": "Routine check"}, {"value": "follow_up", "label": "Follow-up visit"}]
    },
    {
      "id": "previous_reference", "label": "Previous inspection reference", "type": "text", "required": true,
      "visibleWhen": {"fieldId": "inspection_type", "equals": "follow_up"}, "maxLength": 40
    },
    {
      "id": "hazard_found", "label": "Did you find a hazard?", "type": "toggle", "required": true,
      "help": "Selecting Yes reveals the hazard details."
    },
    {
      "id": "hazard_details", "label": "Describe the hazard", "type": "text", "required": true,
      "minLength": 10, "maxLength": 500,
      "visibleWhen": {"fieldId": "hazard_found", "equals": "true"}
    },
    {
      "id": "people_on_site", "label": "People on site", "type": "number", "required": true,
      "minValue": 0, "maxValue": 10000, "help": "Enter a number from 0 to 10,000."
    },
    {"id": "notes", "label": "Additional notes", "type": "text", "maxLength": 500}
  ]
}
